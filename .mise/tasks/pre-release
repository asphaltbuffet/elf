#!/usr/bin/env bash
#MISE description="Batch changie fragments, merge CHANGELOG"
#USAGE arg "bump" help="Version bump type" {
#USAGE   choices "major" "minor" "patch"
#USAGE }

set -euo pipefail

# shellcheck disable=SC2154
bump="${usage_bump}"

# --- Assert unreleased fragments exist ---
fragments=("${PWD}/.changes/unreleased/"*.yaml)
if [ ! -e "${fragments[0]}" ]; then
  echo "Error: no unreleased change fragments in .changes/unreleased/"
  echo "  Use 'changie new' to describe changes before running pre-release."
  exit 1
fi
echo "  ✓ Found $(echo "${fragments[@]}" | wc -w) unreleased fragment(s)"

# --- Batch and merge ---
changie batch "$bump"
changie merge

# --- Get next version ---
next=$(changie latest)
bare="${next#v}"

# --- Assert CHANGELOG entry was written ---
if ! grep -q "^## \[${bare}\]" CHANGELOG.md; then
  echo "Error: changie merge did not produce a '## [${bare}]' entry in CHANGELOG.md"
  exit 1
fi
echo "  ✓ CHANGELOG.md has entry for ${bare}"

echo ""
echo "Done. Commit .changes/, CHANGELOG.md together and open a PR."
echo "After merge, run 'mise run release' to tag and publish."
