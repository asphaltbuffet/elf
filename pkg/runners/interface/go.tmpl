//go:build runtime
// +build runtime

// elf Go runner wrapper harness.
//
// Speaks elf's line-delimited JSON wire protocol (ADR-0002) over stdin/stdout:
//   - reads one Task per line from stdin: task_id, part, input, output_dir
//   - dispatches part to the user's Exercise.One / Two / Vis
//   - writes one Result per line to stdout: task_id, ok, output, duration
//
// This file is generated by elf and re-emitted on every download (it is the
// runner's wrapper template). Do NOT edit it — put your solution in the
// exercise package (exercise.go). This harness imports only the standard
// library plus your exercise package, so it never depends on elf internals.

package main

import (
	"bufio"
	"encoding/json"
	"fmt"
	"os"
	"time"

	ex "{{ index . "import_path" }}"
)

// task mirrors the ADR-0002 wire Task. Field tags are the stable contract.
type task struct {
	TaskID    string `json:"task_id"`
	Part      int    `json:"part"`
	Input     string `json:"input"`
	OutputDir string `json:"output_dir"`
}

// result mirrors the ADR-0002 wire Result. Field tags are the stable contract.
type result struct {
	TaskID   string  `json:"task_id"`
	Ok       bool    `json:"ok"`
	Output   string  `json:"output"`
	Duration float64 `json:"duration"`
}

func sendResult(taskID string, ok bool, output string, duration float64) {
	dat, err := json.Marshal(&result{
		TaskID:   taskID,
		Ok:       ok,
		Output:   output,
		Duration: duration,
	})
	if err != nil {
		panic(err)
	}
	fmt.Println(string(dat))
}

func run() error {
	reader := bufio.NewReader(os.Stdin)
	for {
		taskBytes, err := reader.ReadBytes('\n')
		if err != nil {
			return err
		}

		t := new(task)
		if err := json.Unmarshal(taskBytes, t); err != nil {
			return err
		}

		var solve func() (any, error)

		// Part values are the ADR-0002 wire protocol: 1=PartOne, 2=PartTwo, 3=Visualize.
		switch t.Part {
		case 1:
			solve = func() (any, error) { return (ex.Exercise{}).One(t.Input) }
		case 2:
			solve = func() (any, error) { return (ex.Exercise{}).Two(t.Input) }
		case 3:
			solve = func() (any, error) { return (ex.Exercise{}).Vis(t.Input, t.OutputDir) }
		default:
			sendResult(t.TaskID, false, fmt.Sprintf("unknown task part %d", t.Part), 0)
			continue
		}

		startTime := time.Now()
		res, solveErr := solve()
		runningTime := time.Since(startTime).Seconds()

		if solveErr != nil {
			sendResult(t.TaskID, false, solveErr.Error(), runningTime)
		} else {
			sendResult(t.TaskID, true, fmt.Sprintf("%v", res), runningTime)
		}
	}
}

func main() {
	if err := run(); err != nil {
		panic(err)
	}
}
