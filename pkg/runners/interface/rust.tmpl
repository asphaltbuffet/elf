// elf Rust runner wrapper harness.
//
// Speaks elf's line-delimited JSON wire protocol (ADR-0002) over stdin/stdout:
//   - reads one Task per line from stdin: {"task_id","part","input","output_dir"}
//   - dispatches `part` to the user's solution::part_one / part_two
//   - writes one Result per line to stdout: {"task_id","ok","output","duration"}
//
// This file is generated by elf and re-emitted on every download (it is the
// runner's wrapper template). Do NOT edit it — put your solution in
// src/solution.rs. The crate is a single cargo binary; this is its entrypoint.
//
// No external crates: a minimal hand-rolled JSON reader/writer keeps the
// exercise crate buildable with only the standard library. Your solution.rs may
// add dependencies in Cargo.toml freely; this harness does not constrain them.

mod solution;

use std::io::{self, BufRead, Write};
use std::time::Instant;

fn main() {
    let stdin = io::stdin();
    let stdout = io::stdout();
    let mut out = stdout.lock();

    for line in stdin.lock().lines() {
        let line = match line {
            Ok(l) => l,
            Err(_) => break, // EOF / read error: exit cleanly
        };
        if line.trim().is_empty() {
            continue;
        }

        let task_id = json_str_field(&line, "task_id").unwrap_or_default();
        let part = json_num_field(&line, "part").unwrap_or(0);
        let input = json_str_field(&line, "input").unwrap_or_default();

        let solver: Option<fn(&str) -> String> = match part {
            1 => Some(solution::part_one),
            2 => Some(solution::part_two),
            _ => None,
        };

        let (ok, output, duration) = match solver {
            None => (false, format!("unknown task part: {part}"), 0.0),
            Some(f) => {
                let start = Instant::now();
                // Catch panics so a panicking solution reports ok:false instead
                // of aborting the subprocess and hanging the run (protocol #4).
                let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| f(&input)));
                let duration = start.elapsed().as_secs_f64();
                match res {
                    Ok(answer) => (true, answer, duration),
                    Err(payload) => (false, panic_message(payload), duration),
                }
            }
        };

        let _ = writeln!(out, "{}", encode_result(&task_id, ok, &output, duration));
        let _ = out.flush();
    }
}

fn panic_message(payload: Box<dyn std::any::Any + Send>) -> String {
    if let Some(s) = payload.downcast_ref::<&str>() {
        (*s).to_string()
    } else if let Some(s) = payload.downcast_ref::<String>() {
        s.clone()
    } else {
        "solution panicked".to_string()
    }
}

// --- minimal JSON helpers (stdlib only) ---------------------------------------
//
// Tasks are single-line JSON objects emitted by elf. We extract the few fields
// we need rather than pulling in serde, keeping the exercise crate dependency
// free unless the user's own solution adds crates.

/// Extract a string field's value, decoding standard JSON escape sequences.
fn json_str_field(line: &str, key: &str) -> Option<String> {
    let needle = format!("\"{key}\"");
    let start = line.find(&needle)? + needle.len();
    let rest = &line[start..];
    let colon = rest.find(':')?;
    let after = rest[colon + 1..].trim_start();
    let after = after.strip_prefix('"')?;

    let mut value = String::new();
    let mut chars = after.chars();
    while let Some(c) = chars.next() {
        match c {
            '"' => return Some(value),
            '\\' => match chars.next()? {
                'n' => value.push('\n'),
                't' => value.push('\t'),
                'r' => value.push('\r'),
                '"' => value.push('"'),
                '\\' => value.push('\\'),
                '/' => value.push('/'),
                'u' => {
                    let hex: String = (0..4).filter_map(|_| chars.next()).collect();
                    if let Ok(cp) = u32::from_str_radix(&hex, 16) {
                        if let Some(ch) = char::from_u32(cp) {
                            value.push(ch);
                        }
                    }
                }
                other => value.push(other),
            },
            _ => value.push(c),
        }
    }
    None
}

/// Extract an integer field's value (e.g. "part": 2).
fn json_num_field(line: &str, key: &str) -> Option<i64> {
    let needle = format!("\"{key}\"");
    let start = line.find(&needle)? + needle.len();
    let rest = &line[start..];
    let colon = rest.find(':')?;
    let digits: String = rest[colon + 1..]
        .trim_start()
        .chars()
        .take_while(|c| c.is_ascii_digit() || *c == '-')
        .collect();
    digits.parse().ok()
}

/// Encode a Result line as JSON, escaping the dynamic string fields.
///
/// NOTE: this file is rendered through Go's text/template before compilation, so
/// it must not contain a doubled-open or doubled-close brace (Go template action
/// delimiters). We therefore build the JSON by pushing literal braces as their
/// own char pieces rather than using Rust's doubled-brace format escapes.
fn encode_result(task_id: &str, ok: bool, output: &str, duration: f64) -> String {
    let open = '{';
    let close = '}';
    let mut s = String::new();
    s.push(open);
    s.push_str("\"task_id\":\"");
    s.push_str(&json_escape(task_id));
    s.push_str("\",\"ok\":");
    s.push_str(if ok { "true" } else { "false" });
    s.push_str(",\"output\":\"");
    s.push_str(&json_escape(output));
    s.push_str("\",\"duration\":");
    s.push_str(&duration.to_string());
    s.push(close);
    s
}

fn json_escape(s: &str) -> String {
    let mut out = String::with_capacity(s.len());
    for c in s.chars() {
        match c {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
            c => out.push(c),
        }
    }
    out
}
