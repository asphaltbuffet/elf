// elf C# runner wrapper harness.
//
// Speaks elf's line-delimited JSON wire protocol (ADR-0002) over stdin/stdout:
//   - reads one Task per line from stdin: {"task_id","part","input","output_dir"}
//   - dispatches `part` to the user's Solution.PartOne / PartTwo / Visualize
//   - writes one Result per line to stdout: {"task_id","ok","output","duration"}
//
// This file is generated by elf and re-emitted on every download (it is the
// runner's wrapper template). Do NOT edit it — put your solution in Solution.cs.
// The SDK-style project globs both files into one assembly; this file has Main.
//
// Uses only System.Text.Json from the base class library, so the exercise
// project stays dependency-free. Your Solution.cs may add NuGet packages freely.

using System.Diagnostics;
using System.Text.Json;

string? line;
while ((line = Console.In.ReadLine()) != null)
{
    if (string.IsNullOrWhiteSpace(line))
    {
        continue;
    }

    // Best-effort task_id for error reporting: line may fail to parse at all,
    // in which case we still report ok:false with an empty task_id rather
    // than letting the exception escape the loop and kill the subprocess.
    string taskId = "";
    bool ok;
    string output;
    double duration = 0;

    var sw = Stopwatch.StartNew();
    try
    {
        // Catch exceptions so malformed input or a throwing solution reports
        // ok:false instead of aborting the subprocess and hanging the run
        // (protocol requirement). This covers JSON parsing, field
        // extraction, AND dispatch, since any of them can throw.
        using JsonDocument doc = JsonDocument.Parse(line);
        JsonElement root = doc.RootElement;

        taskId = GetString(root, "task_id");
        int part = GetInt(root, "part");
        string input = GetString(root, "input");
        string outputDir = GetString(root, "output_dir");

        output = part switch
        {
            1 => Solution.PartOne(input),
            2 => Solution.PartTwo(input),
            3 => Solution.Visualize(input, outputDir),
            _ => throw new ArgumentException("unknown task part: " + part),
        };
        ok = true;
    }
    catch (Exception ex)
    {
        output = ex.Message;
        ok = false;
    }
    finally
    {
        duration = sw.Elapsed.TotalSeconds;
    }

    WriteResult(taskId, ok, output, duration);
}

static string GetString(JsonElement root, string key)
{
    return root.TryGetProperty(key, out JsonElement v) ? (v.GetString() ?? "") : "";
}

static int GetInt(JsonElement root, string key)
{
    return root.TryGetProperty(key, out JsonElement v) ? v.GetInt32() : 0;
}

static void WriteResult(string taskId, bool ok, string output, double duration)
{
    var result = new Dictionary<string, object>
    {
        ["task_id"] = taskId,
        ["ok"] = ok,
        ["output"] = output,
        ["duration"] = duration,
    };
    Console.WriteLine(JsonSerializer.Serialize(result));
    Console.Out.Flush();
}
