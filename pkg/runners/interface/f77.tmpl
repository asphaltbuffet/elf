/*
 * elf Fortran 77 runner wrapper harness.
 *
 * Speaks elf's line-delimited JSON wire protocol (ADR-0002) over stdin/stdout:
 *   - reads one Task per line from stdin: {"task_id","part","input","output_dir"}
 *   - writes the puzzle input to a temp file, passes the path to the Fortran subroutine
 *   - writes one Result per line to stdout: {"task_id","ok","output","duration"}
 *
 * This file is generated by elf. Do NOT edit it — put your solution in solution.f.
 * Both files are compiled together: gfortran -O2 -o binary runtime-wrapper.c solution.f
 *
 * Fortran 77 subroutine signatures (in solution.f):
 *
 *   SUBROUTINE PART_ONE(INPUT_PATH, ANSWER, ANSWER_LEN)
 *   CHARACTER*(*) INPUT_PATH
 *   CHARACTER*256 ANSWER
 *   INTEGER ANSWER_LEN
 *   END
 *
 *   SUBROUTINE PART_TWO(INPUT_PATH, ANSWER, ANSWER_LEN)
 *   CHARACTER*(*) INPUT_PATH
 *   CHARACTER*256 ANSWER
 *   INTEGER ANSWER_LEN
 *   END
 *
 * gfortran mangles Fortran subroutine names to lowercase with a trailing
 * underscore, and passes CHARACTER*(*) as (char*, hidden_len) where the
 * hidden length is appended after all explicit arguments.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <unistd.h>

/* Fortran 77 subroutine prototypes (gfortran name mangling: lowercase + underscore).
 * CHARACTER*(*) INPUT_PATH -> (char *input_path, int input_path_len) hidden length appended last.
 * CHARACTER*256 ANSWER     -> (char *answer) fixed-size, no hidden length (fixed-size char).
 * INTEGER ANSWER_LEN       -> (int *answer_len)
 */
extern void part_one_(char *input_path, char *answer, int *answer_len,
                      int input_path_len);
extern void part_two_(char *input_path, char *answer, int *answer_len,
                      int input_path_len);

#define ANSWER_SIZE 256
#define LINE_SIZE   (1 << 20)  /* 1 MiB — enough for any AoC input in one JSON line */
#define INPUT_SIZE  (1 << 20)

/* ---- minimal JSON helpers ------------------------------------------------ */

/* Extract a string field from a flat JSON object line into buf (NUL-terminated).
 * Returns 1 on success, 0 if not found. Handles basic \n \t \" \\ escapes. */
static int json_str_field(const char *line, const char *key, char *buf, int bufsz) {
    char needle[128];
    snprintf(needle, sizeof(needle), "\"%s\"", key);
    const char *p = strstr(line, needle);
    if (!p) return 0;
    p += strlen(needle);
    while (*p == ' ' || *p == ':') p++;
    if (*p != '"') return 0;
    p++;
    int i = 0;
    while (*p && *p != '"' && i < bufsz - 1) {
        if (*p == '\\') {
            p++;
            switch (*p) {
                case 'n':  buf[i++] = '\n'; break;
                case 't':  buf[i++] = '\t'; break;
                case 'r':  buf[i++] = '\r'; break;
                case '"':  buf[i++] = '"';  break;
                case '\\': buf[i++] = '\\'; break;
                case '/':  buf[i++] = '/';  break;
                case 'b':  buf[i++] = '\b'; break;
                case 'f':  buf[i++] = '\f'; break;
                case 'u': {
                    /* \uXXXX — Go's encoding/json escapes <, >, & as <,
                     * >, & by default, so we must decode these.
                     * Decode the BMP code point and emit it as UTF-8. */
                    int cp = 0, k;
                    for (k = 0; k < 4 && p[1]; k++) {
                        char h = *(++p);
                        cp <<= 4;
                        if (h >= '0' && h <= '9')      cp |= h - '0';
                        else if (h >= 'a' && h <= 'f') cp |= h - 'a' + 10;
                        else if (h >= 'A' && h <= 'F') cp |= h - 'A' + 10;
                        else { cp >>= 4; break; }
                    }
                    if (cp < 0x80) {
                        buf[i++] = (char)cp;
                    } else if (cp < 0x800) {
                        if (i < bufsz - 2) {
                            buf[i++] = (char)(0xC0 | (cp >> 6));
                            buf[i++] = (char)(0x80 | (cp & 0x3F));
                        }
                    } else {
                        if (i < bufsz - 3) {
                            buf[i++] = (char)(0xE0 | (cp >> 12));
                            buf[i++] = (char)(0x80 | ((cp >> 6) & 0x3F));
                            buf[i++] = (char)(0x80 | (cp & 0x3F));
                        }
                    }
                    break;
                }
                default:   buf[i++] = *p;   break;
            }
        } else {
            buf[i++] = *p;
        }
        p++;
    }
    buf[i] = '\0';
    return 1;
}

/* Extract an integer field. Returns 0 if not found. */
static int json_int_field(const char *line, const char *key) {
    char needle[128];
    snprintf(needle, sizeof(needle), "\"%s\"", key);
    const char *p = strstr(line, needle);
    if (!p) return 0;
    p += strlen(needle);
    while (*p == ' ' || *p == ':') p++;
    return atoi(p);
}

/* Emit a Result JSON line to stdout. output must be JSON-safe (we escape it). */
static void send_result(const char *task_id, int ok,
                        const char *output, double duration) {
    /* Escape output string */
    char escaped[ANSWER_SIZE * 2 + 4];
    int ei = 0;
    for (int i = 0; output[i] && ei < (int)sizeof(escaped) - 4; i++) {
        unsigned char c = (unsigned char)output[i];
        if (c == '"')       { escaped[ei++] = '\\'; escaped[ei++] = '"'; }
        else if (c == '\\') { escaped[ei++] = '\\'; escaped[ei++] = '\\'; }
        else if (c == '\n') { escaped[ei++] = '\\'; escaped[ei++] = 'n'; }
        else if (c == '\r') { escaped[ei++] = '\\'; escaped[ei++] = 'r'; }
        else if (c == '\t') { escaped[ei++] = '\\'; escaped[ei++] = 't'; }
        else escaped[ei++] = c;
    }
    escaped[ei] = '\0';

    printf("{\"task_id\":\"%s\",\"ok\":%s,\"output\":\"%s\",\"duration\":%.9f}\n",
           task_id, ok ? "true" : "false", escaped, duration);
    fflush(stdout);
}

/* ---- main loop ----------------------------------------------------------- */

int main(void) {
    char *line  = malloc(LINE_SIZE);
    char *input = malloc(INPUT_SIZE);
    if (!line || !input) { fputs("elf-f77: out of memory\n", stderr); return 1; }

    while (fgets(line, LINE_SIZE, stdin)) {
        /* Skip blank lines */
        int blank = 1;
        for (int i = 0; line[i]; i++) if (line[i] != '\n' && line[i] != '\r' && line[i] != ' ') { blank = 0; break; }
        if (blank) continue;

        char task_id[256] = {0};
        json_str_field(line, "task_id", task_id, sizeof(task_id));
        int part = json_int_field(line, "part");
        json_str_field(line, "input", input, INPUT_SIZE);

        /* Write puzzle input to a temp file */
        char tmp_path[] = "/tmp/elf_f77_input_XXXXXX";
        int fd = mkstemp(tmp_path);
        if (fd < 0) {
            send_result(task_id, 0, "failed to create temp file for input", 0.0);
            continue;
        }
        size_t input_len = strlen(input);
        if (write(fd, input, input_len) != (ssize_t)input_len) {
            close(fd);
            unlink(tmp_path);
            send_result(task_id, 0, "failed to write input to temp file", 0.0);
            continue;
        }
        close(fd);

        char answer[ANSWER_SIZE];
        memset(answer, ' ', sizeof(answer)); /* Fortran pads with spaces */
        int answer_len = 0;
        int path_len = (int)strlen(tmp_path);

        struct timespec t0, t1;
        clock_gettime(CLOCK_MONOTONIC, &t0);

        switch (part) {
            case 1: part_one_(tmp_path, answer, &answer_len, path_len); break;
            case 2: part_two_(tmp_path, answer, &answer_len, path_len); break;
            default:
                unlink(tmp_path);
                send_result(task_id, 0, "unknown task part", 0.0);
                continue;
        }

        clock_gettime(CLOCK_MONOTONIC, &t1);
        double duration = (t1.tv_sec - t0.tv_sec) + (t1.tv_nsec - t0.tv_nsec) * 1e-9;

        unlink(tmp_path);

        /* Trim trailing Fortran spaces from answer */
        if (answer_len > 0 && answer_len <= ANSWER_SIZE) {
            while (answer_len > 0 && answer[answer_len - 1] == ' ') answer_len--;
            answer[answer_len] = '\0';
        } else {
            /* Fallback: trim from fixed buffer */
            int trim = ANSWER_SIZE - 1;
            while (trim > 0 && answer[trim - 1] == ' ') trim--;
            answer[trim] = '\0';
        }

        send_result(task_id, 1, answer, duration);
    }

    free(line);
    free(input);
    return 0;
}
